# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──────────────────────────────────────
.venv/
venv/
.python-version

# ── IDE / Editor ──────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ── Dataset (too large for version control) ───────────────────
dataset/

# ── Model artefacts ───────────────────────────────────────────
models/*.keras
models/*.h5
models/logs/

# ── Plots (regenerated by generate_figures.py) ────────────────
plots/

