!plots/others/class_distribution.png
!plots/DINOv3/learning_curves.png
!plots/DINOv3/model_architecture.png
!plots/DINOv3/training_timeline_overview.png
!plots/DINOv3/confusion_matrix.png
!plots/DINOv3/sample_predictions.png

# --- Testing & Coverage ---
.pytest_cache/
htmlcov/
.coverage
*.log

# --- OS Specific ---
.DS_Store
Thumbs.db

