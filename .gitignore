uploads/*
!uploads/.gitkeep

# ── Testing / CI ──────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs and temp files ──────────────────────────────────────
*.log
*.tmp
*.deb

# ── Package manager ──────────────────────────────────────────
uv.lock
