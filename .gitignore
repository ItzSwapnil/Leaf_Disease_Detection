# ==============================================================================
# Leaf Disease Detection AI - Git Ignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.ruff_cache/
.mypy_cache/

# --- Virtual Environments ---
.venv/
venv/
env/
.python-version
.venv_old

# --- IDEs & Editors ---
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.agents/

# --- Dataset (large/local files) ---
dataset

*.zip
dataset.zip
ignored_crops/
EXP/

# --- Model Artifacts & Runs ---
/models/*
!/models/.gitkeep
/models/logs/
/models/archived/
/logs/
*.pt
*.pt.tmp

# --- Temporary & Upload Files ---
/uploads/*
!/uploads/.gitkeep
*.tmp
*.deb
annotations

# --- LaTeX Document Repos & Builds ---
TAI_LaTex/
Thesis/
*.bbl
*.blg
*.synctex.gz
*.aux
*.out
*.fls
*.fdb_latexmk

# --- Plots & Scratch Outputs ---
plots/**/*.pdf
plots/**/*.png
plots/**/*.webp
scratch/*.png
/zzplots/
/xxplotsxx/
/ignored_plots/
# Allow tracking generated evaluation figures for README
!plots/others/*
!plots/DINOv3/*

# --- Testing & Coverage ---
.pytest_cache/
htmlcov/
.coverage
*.log

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Miscellaneous ---
leaf-disease.ipynb
dataset_plantvillage
plantdoc_download
